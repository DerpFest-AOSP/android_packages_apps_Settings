<resources>

    <!-- List of system apps that are allowed to configure per-app settings -->
    <string-array name="config_perAppConfAllowedSystemApps" translatable="false">
        <item>com.android.chrome</item>
        <item>com.android.vending</item>
        <item>com.oneplus.gallery</item>
        <item>com.google.android.apps.docs</item>
        <item>com.google.android.apps.nbu.files</item>
        <item>com.google.android.apps.photos</item>
        <item>com.google.android.apps.recorder</item>
        <item>com.google.android.calculator</item>
        <item>com.google.android.calendar</item>
        <item>com.google.android.gm</item>
    </string-array>

    <!-- Show high touch polling rate option -->
    <bool name="config_supportHighTouchRate" translatable="false">false</bool>

    <!-- Minimum interval (ms) between pickup gestures before triggering doze pulse / wake.
         Default: 2500. Overlay in device config to tune. -->
    <integer name="config_dozePulsePickup_MinPulseIntervalMs" translatable="false">2500</integer>

    <!-- Wakelock timeout (ms) when waking from pickup (raise-to-wake).
         Default: 300. Overlay in device config to tune. -->
    <integer name="config_dozePulsePickup_WakelockTimeoutMs" translatable="false">300</integer>
</resources>
