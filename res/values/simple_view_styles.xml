<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Simple View -->
    <style name="SimpleViewNegativeButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>

    <style name="SimpleViewPositiveButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/simple_view_colored_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>
</resources>
